# .easignore — files EAS Build excludes from the project upload.
#
# IMPORTANT: when this file exists, EAS uses it INSTEAD of .gitignore (not in
# addition), so it must carry over every .gitignore entry below, PLUS the heavy
# build-irrelevant trees that were bloating the upload (owner 2026-08-18: the
# archive / ingest / docs folders are hundreds of MB of old SQL + notes and are
# never needed to build the app). Keep this in sync with .gitignore.

# ── carried over from .gitignore ─────────────────────────────────────────────
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env*.local
*.tsbuildinfo
__pycache__/
*.pyc
/ios
/android

# ── extra: large folders that are NOT part of the app build ──────────────────
audio_app_archive/
machineA_ingest/
docs/
