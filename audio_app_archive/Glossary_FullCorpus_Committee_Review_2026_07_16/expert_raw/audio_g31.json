   "id": "5866c5d3-b1a0-4263-8d17-cf726894f7ec",
   "term": "Multimeter",
   "verdict": "MINOR",
   "suggestions": [
    {
     "field": "practical_application",
     "severity": "Low",
     "issue": "PRAC says the multimeter is used to 'measure resistance/impedance of loads'. A standard multimeter measures only DC resistance; it cannot measure AC impedance (which is frequency-dependent). Conflating the two is a classic student trap in audio \u2014 e.g., measuring an '8-ohm' speaker yields ~6 ohms of DC resistance (DCR), not its rated impedance.",
     "suggestion": "Change 'measure resistance/impedance of loads' to 'measure DC resistance (DCR) of loads' (and, if desired, add a note that rated speaker impedance is an AC quantity a DMM does not read)."
    }
   ]
