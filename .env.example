# Copy to .env (git-ignored) and fill in the real values from the Supabase
# dashboard (Settings -> API). The anon key is the *publishable* key — safe to
# embed. Never place any other Supabase key here (Code brief §1); an example
# file carries placeholders only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
