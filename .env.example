# Copy to .env (git-ignored) and fill in the real values from the Supabase
# dashboard (Settings -> API). The anon key is the *publishable* key — safe to
# embed. Never place any other Supabase key here (Code brief §1); an example
# file carries placeholders only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Telemetry (2026-09-16, privacy-first). Both are CLIENT-SIDE app identifiers,
# not secrets — they ship in the binary by design. Leave either blank to keep
# that SDK off; src/config/telemetry.ts is the master kill switch for both.
# Sentry DSN (crash / diagnostics) and Aptabase App Key (A-EU-… = EU host).
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXXXX.ingest.us.sentry.io/XXXXXXXX
EXPO_PUBLIC_APTABASE_APP_KEY=A-EU-0000000000
# Dev only: set to 1 for ONE Metro run to fire a test event + test error at boot.
# EXPO_PUBLIC_TELEMETRY_SELFTEST=1
