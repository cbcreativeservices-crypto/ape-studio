{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Pure modules under test import siblings with an explicit `.ts` so Node's
    // native runner (`node --test`, ESM, no bundler) can resolve them. Metro
    // resolves explicit extensions too; Expo's base config already sets noEmit.
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "web",
    "supabase",
    "shared",
    "audio_app_archive",
    "test"
  ]
}
