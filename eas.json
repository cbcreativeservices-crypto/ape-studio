{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "buildArtifactPaths": ["ios/build/**/*.dSYM.zip", "ios/build/**/*.dSYM"]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
