{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-blocks.cjs\"",
            "statusMessage": "Rule guard (build / no-verify / images)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/PROTOCOL_CHECK.md\" 2>/dev/null || cat .claude/PROTOCOL_CHECK.md 2>/dev/null || true",
            "statusMessage": "Protocol check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-file-paths.cjs\"",
            "statusMessage": "File-path rule check"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "grep -qE '^(affects other side|needs): <FILL' \"$CLAUDE_PROJECT_DIR/docs/CROSS_SESSION_HANDOFF.md\" 2>/dev/null && echo '[sync channel] docs/CROSS_SESSION_HANDOFF.md has an unfilled stub from your last commit — fill its affects-other-side / needs lines (or set them to \"nothing\") so A gets a complete picture; it rides into your next commit.' || true",
            "statusMessage": "Sync-channel stub check"
          }
        ]
      }
    ]
  }
}
