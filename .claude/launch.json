{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "expo-tunnel",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--tunnel", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "expo-device",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--dev-client", "--clear"],
      "port": 8081
    },
    {
      "name": "mic-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", "docs/art/mic-cutaway", "-p", "8123", "-c-1"],
      "port": 8123
    }
  ]
}
